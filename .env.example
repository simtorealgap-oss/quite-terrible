# Copy to .env and fill in. Never commit .env.

# Korea prices come from Danawa search pages and need no key.
# Daily price check hour in Korea time (default 9 = 09:00 KST).
PRICE_RUN_HOUR_KST=9

# Optional: Coupang Partners API keys (partners.coupang.com → Tools → 파트너스 API, final approval required).
# Shows Coupang's own price beside the Danawa comparison; without keys nothing is called.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# US prices — eBay Browse API (https://developer.ebay.com/my/keys, Production keyset).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: eBay Partner Network campaign id, makes item links affiliate links.
EBAY_CAMPAIGN_ID=

# US prices — Best Buy Products API key (https://developer.bestbuy.com, company email required).
BESTBUY_API_KEY=

# Optional: HTTPS JSON feed from a seller or licensed provider (format: config/feed.example.json).
PRICE_FEED_URL=
